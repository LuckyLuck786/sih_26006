# Harborline — environment template
#
# Copy to .env (git-ignored) and fill in. Never commit the real file:
# this repository is public.

# ---------------------------------------------------------------
# Optional: live AIS vessel positions from Data Docked
# ---------------------------------------------------------------
# Everything works without this. The map falls back to the tracked
# fleet and labels itself "Simulated fleet".
#
# Used by:
#   backend/main.py        -> /ais/vessels-by-area
#   frontend/api/ais.js    -> /api/ais  (Vercel serverless function)
#
# IMPORTANT: this must NOT be prefixed VITE_. Vite compiles VITE_*
# variables into the public JavaScript bundle, which would publish the
# key. It is read server-side only.
#
# On Vercel this value is NOT read from a committed file — set it in
# Project Settings -> Environment Variables, or run:
#   vercel env add DATADOCKED_API_KEY production
DATADOCKED_API_KEY=
