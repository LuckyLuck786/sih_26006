# Frontend environment template — copy to .env.local (git-ignored)

# Leave unset (or "true") to run the decision engine in the browser using
# the trained models' exported forecasts. No backend needed.
#
# Set to "false" to call the FastAPI service in backend/ instead.
VITE_USE_MOCK=true

# Only used when VITE_USE_MOCK=false
VITE_API_BASE_URL=http://localhost:8000

# Do NOT put DATADOCKED_API_KEY here. Anything prefixed VITE_ is compiled
# into the public bundle. The key belongs in the server environment —
# see the .env.example at the repository root.
